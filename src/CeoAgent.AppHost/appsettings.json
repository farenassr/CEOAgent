{
  "Resources": {
    "Storage": "storage",
    "Queues": "queues",
    "Blobs": "blobs"
  },
  "PgAdmin": {
    "Enabled": true,
    "DefaultEmail": "admin@ceoagent.dev",
    "HostPort": 5050,
    "Image": "docker.io/dpage/pgadmin4:latest"
  },
  "Postgres": {
    "ResourceName": "postgres",
    "Host": "postgres",
    "Port": 5432,
    "HostPort": 55432,
    "Username": "postgres",
    "PasswordSecretName": "PostgresPassword",
    "DatabaseName": "CeoAgent"
  },
  "ApiService": {
    "HttpsHostPort": 7584,
    "HttpHostPort": 5481
  },
  "Azurite": {
    "BlobPort": 10000,
    "QueuePort": 10001,
    "TablePort": 10002
  },
  "Keycloak": {
    "ClientId": "ceo-agent-api",
    "ServiceClientId": "ceo-agent-service",
    "Issuer": "https://ceo-agent-keycloak.icybush-34e28ac8.westus2.azurecontainerapps.io/realms/ceo-agent",
    "RedirectUri": "https://api.purplebeach-6a45be11.westus2.azurecontainerapps.io/scalar/",
    "AuthorizationScopes": [
      "openid",
      "profile",
      "email",
      "organization"
    ]
  },
  "ServiceDefaults": {
    "Langfuse": {
      "Host": "https://cloud.langfuse.com"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
