{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Cors": {
      "AllowedOrigins": []
    },
    "RateLimiting": {
      "AutoReplenishment": true,
      "PermitLimit": 120,
      "QueueLimit": 0,
      "WindowSeconds": 60
    }
  },
  "Persistence": {
    "UseInMemoryDatabase": false,
    "InMemoryDatabaseName": "CeoAgent"
  },
  "Keycloak": {
    "ClientId": "ceo-agent-api",
    "Issuer": "https://ceo-agent-keycloak.icybush-34e28ac8.westus2.azurecontainerapps.io/realms/ceo-agent",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "organization"
    ],
    "ScopeDescriptions": {
      "openid": "OpenID Connect sign-in",
      "profile": "User profile claims",
      "email": "User email claims",
      "organization": "Keycloak organization membership claim"
    }
  },
  "ServiceDefaults": {
    "Otlp": {
      "Endpoint": ""
    },
    "Langfuse": {
      "Host": "",
      "OtlpTracesEndpoint": "",
      "PublicKey": "",
      "SecretKey": ""
    }
  },
  "AllowedHosts": "*"
}
