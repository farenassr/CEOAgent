{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Cors": {
      "AllowedOrigins": []
    },
    "RateLimiting": {
      "AutoReplenishment": true,
      "PermitLimit": 120,
      "QueueLimit": 0,
      "WindowSeconds": 60
    }
  },
  "Persistence": {
    "ApplyMigrationsOnStartup": true,
    "UseInMemoryDatabase": false,
    "InMemoryDatabaseName": "CeoAgent"
  },
  "ServiceDefaults": {
    "Otlp": {
      "Endpoint": ""
    },
    "Langfuse": {
      "Host": "",
      "OtlpTracesEndpoint": "",
      "PublicKey": "",
      "SecretKey": ""
    },
    "LangSmith": {
      "OtlpTracesEndpoint": "https://api.smith.langchain.com/otel/v1/traces",
      "Project": "CeoAgent",
      "ApiKey": ""
    }
  },
  "AllowedHosts": "*"
}
